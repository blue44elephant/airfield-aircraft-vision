  "findings": [
    {
      "finding": "Small-object recall is the primary measured weakness.",
      "evidence": "Fresh AW-01B cohort: 6/43 small source-pixel labels matched (13.95%), versus 9/36 medium (25%) and 2/2 large (too few for inference). MobileNet native feature strides are 32/32/64.",
      "causality_limit": "Stride is a plausible contributor; no controlled architectural intervention in AW-01B established its causal share."
    },
    {
      "finding": "Crowded-apron scenes can fail completely.",
      "evidence": "Hagerstown tile 61_104001002F594F00_tile_64.png has 10 labels and 0 accepted detections. Review computed crowd-count strata from all exposed records.",
      "causality_limit": "Tile annotation density is a proxy; partial/truncated labels and aircraft scale confound crowding."
    },
    {
      "finding": "Localization and background confusion coexist.",
      "evidence": "Preserved AW-01B native snow example 76_104001004941CB00_tile_147.png has 1 TP, 3 FP, 1 FN. Prior visual review identifies an aircraft box below IoU 0.5 plus snow/background confusers.",
      "causality_limit": "Unmatched boxes are FP relative to supplied labels; not every unmatched prediction is a distinct non-aircraft object."
    },
